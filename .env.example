# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for canonical links, sitemap, RSS and social cards.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Chat assistant (the portfolio-assistant Cloudflare Worker). Server-only, never NEXT_PUBLIC.
ASSISTANT_URL=https://portfolio-assistant.your-subdomain.workers.dev/chat
ASSISTANT_SECRET=same-value-as-the-worker-secret
